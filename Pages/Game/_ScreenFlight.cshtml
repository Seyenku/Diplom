<!-- _ScreenFlight.cshtml — Экран полёта / сбор кристаллов -->
<div class="screen" id="screen-flight" style="width:100%;height:100%;position:relative;">

    <!-- Оверлей разгона (Стейт 1) -->
    <div id="flight-accel-overlay" class="flight-accel-overlay">
        <div id="flight-accel-label" class="flight-accel-label">УСКОРЕНИЕ 0%</div>
        <div class="flight-accel-track">
            <div id="flight-accel-bar" class="flight-accel-fill"></div>
        </div>
        <p class="countdown-subtitle">Подготовка к прыжку...</p>
    </div>

    <!-- HUD полёта (Стейт 2) — поверх Three.js canvas -->
    <div id="flight-hud" class="flight-hud hidden">
        <!-- Верхний блок: статы + прогресс волны -->
        <div class="flight-hud-top-wrap">
            <div class="flight-hud-top">
                <div class="flight-stat-group" title="Кристаллы в трюме / ёмкость">
                    <span class="flight-stat-icon">💎</span>
                    <span id="flight-crystals-count" class="flight-stat-value">0</span>
                    <span id="flight-capacity-label" style="font-size:0.75rem;color:var(--color-text-muted);margin-left:2px;">/ 20</span>
                </div>
                <div class="flight-stat-group" style="font-size:0.75rem;">
                    <span id="flight-crystal-type" style="color:var(--color-text-muted);">💎 Программирование</span>
                </div>
                <div class="flight-stat-group">
                    <span class="flight-stat-icon">🛡</span>
                    <div class="flight-bar-track">
                        <div id="flight-shield-bar" class="flight-bar-fill flight-bar-shield" style="width:100%"></div>
                    </div>
                </div>
                <div class="flight-stat-group" title="Энергия буста">
                    <span class="flight-stat-icon">⚡</span>
                    <div class="flight-bar-track">
                        <div id="flight-energy-bar" class="flight-bar-fill" style="width:100%;background:linear-gradient(90deg,#39ff14,#a3e635);"></div>
                    </div>
                </div>
                <div class="flight-stat-group">
                    <span class="flight-stat-icon">⏱</span>
                    <span id="flight-timer" class="flight-stat-value">60</span>
                </div>
            </div>
            <!-- Прогресс-бар волны -->
            <div class="flight-wave-row">
                <span id="flight-wave-label" class="flight-wave-label">Волна 1/3</span>
                <div class="flight-bar-track flight-bar-track--wave">
                    <div id="flight-wave-bar" class="flight-bar-fill" style="width:0%;background:#4ade80;"></div>
                </div>
            </div>
        </div>

        <!-- Подсказки управления — заполняются JS, видны только во время разгона -->
        <div id="flight-hints" class="flight-hints">
            <!-- renderControlHints() -->
        </div>

        <!-- Комбо-множитель -->
        <div id="flight-combo" class="flight-combo hidden">×1</div>
    </div>

    <!-- Hit flash overlay (для фазы 2) -->
    <div id="flight-hit-flash" class="flight-hit-flash"></div>

    <!-- Damage overlay (критический щит) -->
    <div id="flight-damage-overlay" class="flight-damage-overlay"></div>

    <!-- Оверлей результатов (Стейт 3) -->
    <div id="flight-results" class="flight-results-overlay hidden" aria-modal="true" role="dialog">
        <article class="flight-results-card" data-rating="C">
            <header class="flight-results-head">
                <span class="flight-results-eyebrow">Полёт завершён</span>
                <div class="flight-results-rating" id="result-rating">C</div>
                <p class="flight-results-rating-label" id="result-rating-label">Дебют</p>
            </header>

            <div class="flight-results-stats">
                <div class="flight-results-stat" data-stat="crystals">
                    <span class="flight-results-stat-value" id="result-crystals">+0</span>
                    <span class="flight-results-stat-label" id="result-crystals-label">Кристаллов</span>
                </div>
                <div class="flight-results-stat" data-stat="shield">
                    <span class="flight-results-stat-value" id="result-shield">100%</span>
                    <span class="flight-results-stat-label">Щитов</span>
                </div>
                <div class="flight-results-stat" data-stat="combo">
                    <span class="flight-results-stat-value" id="result-combo">×1</span>
                    <span class="flight-results-stat-label">Макс. комбо</span>
                </div>
                <div class="flight-results-stat" data-stat="dodged">
                    <span class="flight-results-stat-value" id="result-dodged">0</span>
                    <span class="flight-results-stat-label">Уклонений</span>
                </div>
            </div>

            <div class="flight-results-actions">
                <button type="button" class="flight-results-btn flight-results-btn--primary"
                        onclick="window._flightScreen?.restart()">
                    Ещё раз
                </button>
                <button type="button" class="flight-results-btn flight-results-btn--secondary"
                        data-spa="goto" data-screen="galaxy-map">
                    К карте
                </button>
            </div>
        </article>
    </div>
</div>
