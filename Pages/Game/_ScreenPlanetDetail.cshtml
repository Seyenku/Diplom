<!-- _ScreenPlanetDetail.cshtml — Planet details / profession with 3D -->
<div class="screen" id="screen-planet-detail">

    <!-- 3D planet viewport (background center) -->
    <div id="planet-3d-viewport" class="planet-3d-viewport">
        <div class="skeleton-shimmer"></div>
    </div>

    <!-- UI overlay -->
    <div class="planet-detail-overlay">
        <div id="planet-player-crystals" class="planet-player-crystals">💎 Кристаллы: 0</div>

        <div class="planet-detail-header">
            <p id="planet-category" class="game-subtitle">…</p>
            <h1 id="planet-name" class="game-title no-navbar-clearance">…</h1>
            <p id="planet-description" class="planet-description">…</p>
        </div>

        <div class="planet-detail-content">

            <!-- Left column: hard + soft -->
            <div class="planet-detail-side">
                <article class="planet-card" data-card="hard">
                    <header class="planet-card-head">
                        <span class="planet-card-eyebrow">Hard skills</span>
                        <h3 class="planet-card-title">Что нужно знать</h3>
                    </header>
                    <ul id="hard-skills-list" class="planet-skill-list"></ul>
                </article>

                <article class="planet-card" data-card="soft">
                    <header class="planet-card-head">
                        <span class="planet-card-eyebrow">Soft skills</span>
                        <h3 class="planet-card-title">Личные качества</h3>
                    </header>
                    <ul id="soft-skills-list" class="planet-skill-list"></ul>
                </article>
            </div>

            <!-- Right column: risks + programs -->
            <div class="planet-detail-side">
                <article class="planet-card" data-card="risks">
                    <header class="planet-card-head">
                        <span class="planet-card-eyebrow">Risks</span>
                        <h3 class="planet-card-title">Чего стоит опасаться</h3>
                    </header>
                    <ul id="risks-list" class="planet-skill-list"></ul>
                </article>

                <article id="planet-programs" class="planet-card hidden" data-card="programs">
                    <header class="planet-card-head">
                        <span class="planet-card-eyebrow">Programs</span>
                        <h3 class="planet-card-title">Где учиться</h3>
                    </header>
                    <div id="programs-list" class="planet-programs-list"></div>
                </article>
            </div>

        </div>

        <div class="planet-detail-actions">
            <button id="btn-play-minigame" class="btn-game btn-primary btn-action" data-action="planetDetail.startMiniGame">
                🎮 Пробная посадка
            </button>
            <button class="btn-game btn-secondary btn-action" data-spa="goBack">
                ← Назад
            </button>
        </div>

    </div>
</div>
