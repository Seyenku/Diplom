<!-- _ScreenGalaxyMap.cshtml — Звёздная карта: 3 туманности -->
<div class="screen galaxy-map-screen" id="screen-galaxy-map">

    <!-- ═══ Контент: 3D Вид ═══ -->
    <div id="galaxy-3d-container" class="galaxy-content-panel galaxy-3d-container">
        <div id="galaxy-3d-canvas-wrap" class="galaxy-3d-canvas-wrap">

            <!-- Тултип при наведении -->
            <div id="galaxy-tooltip" class="galaxy-tooltip hidden">
                <div id="galaxy-tooltip-name" class="galaxy-tooltip-name"></div>
                <div id="galaxy-tooltip-cat" class="galaxy-tooltip-cat"></div>
                <div id="galaxy-tooltip-hint" class="galaxy-tooltip-hint">ЛКМ — выбрать</div>
            </div>

            <!-- Backdrop (только в mobile-режиме за панелью) -->
            <div id="nebula-backdrop" class="nebula-backdrop hidden"
                 data-action="galaxyMap.collapseNebula"
                 aria-hidden="true"></div>

            <!-- FAB-стек для свёрнутого режима на mobile (когда панель полностью скрыта).
                 Содержит кнопку «список планет» + кнопку «Полёт» в одной группе. -->
            <div id="nebula-fab-stack" class="nebula-fab-stack hidden">
                <button id="nebula-fab-fly" class="nebula-fab nebula-fab--fly" type="button"
                        data-action="galaxyMap.flyToRegion"
                        aria-label="Перейти к полёту">
                    <span class="nebula-fab-icon">🚀</span>
                </button>
                <button id="nebula-fab" class="nebula-fab" type="button"
                        data-action="galaxyMap.expandNebula"
                        aria-label="Открыть список планет">
                    <span class="nebula-fab-icon" id="nebula-fab-icon">📋</span>
                    <span class="nebula-fab-count" id="nebula-fab-count">0</span>
                </button>
            </div>

            <!-- Панель выбранного региона / туманности -->
            <div id="nebula-info-panel" class="nebula-info-panel hidden" data-state="full" data-collapsed="false">
                @* Desktop-only: chevron, сворачивает панель в узкую «вкладку» (~56 px). *@
                <button id="nebula-collapse-toggle" class="nebula-collapse-toggle" type="button"
                        data-action="galaxyMap.toggleCollapsed"
                        aria-label="Свернуть/развернуть панель туманности">
                    <span class="nebula-collapse-icon" aria-hidden="true">‹</span>
                </button>

                @* Handle: drag-to-resize + tap-toggle через pointer events (galaxyUi.ts), только mobile *@
                <button id="nebula-handle" class="nebula-handle" type="button"
                        aria-label="Перетащить или коснуться, чтобы изменить размер">
                    <span class="nebula-handle-grip"></span>
                </button>

                <div class="nebula-info-scroll">
                    <div class="nebula-info-header">
                        <span id="nebula-info-icon" class="nebula-info-icon">🌀</span>
                        <div>
                            <div id="nebula-info-name" class="nebula-info-name">Туманность</div>
                            <div id="nebula-info-desc" class="nebula-info-desc"></div>
                        </div>
                    </div>
                    @* Бейдж кол-ва планет: виден только в свёрнутом состоянии. *@
                    <span id="nebula-collapsed-count" class="nebula-collapsed-count" aria-hidden="true">0</span>
                    <div class="nebula-info-stats">
                        <span id="nebula-info-crystal" class="nebula-info-stat">💎 Кристаллы: —</span>
                        <span id="nebula-info-planets" class="nebula-info-stat">🪐 Планет: —</span>
                    </div>
                    <button id="btn-nebula-fly" class="btn-game btn-primary nebula-fly-btn" data-action="galaxyMap.flyToRegion">
                        <span class="nebula-fly-icon" aria-hidden="true">🚀</span>
                        <span class="nebula-fly-label">Полёт</span>
                    </button>
                    <!-- Сетка планет региона -->
                    <div id="nebula-planet-grid" class="nebula-planet-grid"></div>
                </div>
            </div>

            <!-- Подсказка по навигации -->
            <div class="galaxy-nav-hint">
                🖱 ЛКМ — выбор | Зажать ПКМ / Свайп — вращение | Скролл / Щипок — зум
            </div>
        </div>
    </div>
</div>
