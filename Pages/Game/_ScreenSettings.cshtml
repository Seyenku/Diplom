@*  _ScreenSettings.cshtml — Настройки (modern bento) *@
<main class="screen settings-screen" id="screen-settings" aria-labelledby="settings-title">
    <div class="settings-shell">

        <!-- ═══ Action bar ════════════════════════════════════════ -->
        <header class="settings-actionbar">
            <div class="settings-actionbar-title">
                <h1 id="settings-title" class="settings-pagetitle">Настройки</h1>
                <p class="settings-pagesubtitle">Звук, графика, управление, доступность</p>
            </div>
            <button type="button" class="settings-save-pill"
                    data-action="settings.saveAndApply">
                Применить и сохранить
            </button>
        </header>

        <!-- ═══ Bento Grid ════════════════════════════════════════ -->
        <div class="settings-bento">

            <!-- Аудио -->
            <section class="settings-card" data-section="audio">
                <header class="settings-card-head">
                    <span class="settings-card-eyebrow">Audio</span>
                    <h2 class="settings-card-title">Звук и музыка</h2>
                </header>

                <div class="settings-row">
                    <label class="settings-row-label" for="setting-sound">Громкость звука</label>
                    <div class="settings-range-wrap">
                        <input type="range" class="settings-range" id="setting-sound"
                               min="0" max="100" value="70"
                               data-setting-key="soundVolume" data-setting-display="setting-sound-val" />
                        <span class="settings-range-value" id="setting-sound-val">70%</span>
                    </div>
                </div>

                <div class="settings-row">
                    <label class="settings-row-label" for="setting-music">Громкость музыки</label>
                    <div class="settings-range-wrap">
                        <input type="range" class="settings-range" id="setting-music"
                               min="0" max="100" value="50"
                               data-setting-key="musicVolume" data-setting-display="setting-music-val" />
                        <span class="settings-range-value" id="setting-music-val">50%</span>
                    </div>
                </div>
            </section>

            <!-- Графика -->
            <section class="settings-card" data-section="graphics">
                <header class="settings-card-head">
                    <span class="settings-card-eyebrow">Graphics</span>
                    <h2 class="settings-card-title">Визуальное оформление</h2>
                </header>

                <div class="settings-row">
                    <label class="settings-row-label" for="setting-graphics">Качество графики</label>
                    <select id="setting-graphics" class="settings-select"
                            data-action-change="settings.update" data-arg="graphicsQuality" data-pass="value">
                        <option value="low">Низкое</option>
                        <option value="medium" selected>Среднее</option>
                        <option value="high">Высокое</option>
                    </select>
                </div>

                <div class="settings-row settings-row--toggle">
                    <label class="settings-row-label" for="setting-bloom">Свечение (Bloom)</label>
                    <label class="settings-switch" for="setting-bloom">
                        <input type="checkbox" id="setting-bloom" checked
                               data-action-change="settings.update" data-arg="useBloom" data-pass="checked" />
                        <span class="settings-switch-track"></span>
                    </label>
                </div>
            </section>

            <!-- Управление -->
            <section class="settings-card settings-card--wide" data-section="controls">
                <header class="settings-card-head">
                    <span class="settings-card-eyebrow">Controls</span>
                    <h2 class="settings-card-title">Схема управления</h2>
                </header>

                <div class="settings-row">
                    <label class="settings-row-label" for="setting-controls">Способ ввода</label>
                    <select id="setting-controls" class="settings-select"
                            data-action-change="settings.update" data-arg="controlScheme" data-pass="value">
                        <option value="keyboard" selected>Клавиатура / джойстик</option>
                        <option value="mouse">Мышь / тач по экрану</option>
                    </select>
                </div>

                <div id="settings-keybindings-block" class="settings-keybindings">
                    <p class="settings-keybindings-eyebrow">Горячие клавиши</p>
                    <div class="settings-keybindings-grid">
                        <div class="settings-keybind">
                            <span class="settings-keybind-label">Вперёд</span>
                            <button type="button" class="settings-keybind-btn" id="bind-up"
                                    data-action="settings.startBind" data-arg="up">W</button>
                        </div>
                        <div class="settings-keybind">
                            <span class="settings-keybind-label">Назад</span>
                            <button type="button" class="settings-keybind-btn" id="bind-down"
                                    data-action="settings.startBind" data-arg="down">S</button>
                        </div>
                        <div class="settings-keybind">
                            <span class="settings-keybind-label">Влево</span>
                            <button type="button" class="settings-keybind-btn" id="bind-left"
                                    data-action="settings.startBind" data-arg="left">A</button>
                        </div>
                        <div class="settings-keybind">
                            <span class="settings-keybind-label">Вправо</span>
                            <button type="button" class="settings-keybind-btn" id="bind-right"
                                    data-action="settings.startBind" data-arg="right">D</button>
                        </div>
                        <div class="settings-keybind">
                            <span class="settings-keybind-label">Ускорение</span>
                            <button type="button" class="settings-keybind-btn" id="bind-boost"
                                    data-action="settings.startBind" data-arg="boost">Space</button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Доступность -->
            <section class="settings-card settings-card--wide" data-section="accessibility">
                <header class="settings-card-head">
                    <span class="settings-card-eyebrow">Accessibility</span>
                    <h2 class="settings-card-title">Доступность</h2>
                </header>

                <div class="settings-row">
                    <label class="settings-row-label" for="setting-uiscale">Масштаб интерфейса</label>
                    <div class="settings-range-wrap">
                        <input type="range" class="settings-range" id="setting-uiscale"
                               min="80" max="130" value="100"
                               data-setting-key="uiScale" data-setting-display="setting-uiscale-val" data-setting-scale="0.01" />
                        <span class="settings-range-value" id="setting-uiscale-val">100%</span>
                    </div>
                </div>
            </section>
        </div>
    </div>
</main>
