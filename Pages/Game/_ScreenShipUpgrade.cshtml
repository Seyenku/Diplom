@*  _ScreenShipUpgrade.cshtml — Мастерская корабля (modern layout) *@
<main class="screen ship-screen" id="screen-ship-upgrade" aria-labelledby="ship-title">
    <div class="ship-shell">

        <!-- ═══ Action bar ════════════════════════════════════════ -->
        <header class="ship-actionbar">
            <div class="ship-actionbar-title">
                <h1 id="ship-title" class="ship-pagetitle">Мастерская корабля</h1>
                <p class="ship-pagesubtitle">Модификации навигатора — путь от Кадета до Адмирала</p>
            </div>
            <span id="ship-progress-counter" class="ship-progress-counter" aria-live="polite">0 / 11</span>
        </header>

        <!-- ═══ Hero Stats Panel ═════════════════════════════════════ -->
        <section class="ship-hero" aria-label="Характеристики корабля">
            <div class="ship-hero-craft">
                <div class="ship-hero-glow" aria-hidden="true"></div>
                <div class="ship-hero-icon" aria-hidden="true">🚀</div>
                <div class="ship-hero-rings" aria-hidden="true">
                    <span class="ship-hero-ring ship-hero-ring--1"></span>
                    <span class="ship-hero-ring ship-hero-ring--2"></span>
                </div>
            </div>
            <div class="ship-hero-stats">
                <article class="ship-stat" data-stat="speed" style="--accent:#4fc3f7;">
                    <div class="ship-stat-header">
                        <span class="ship-stat-icon" aria-hidden="true">⚡</span>
                        <span class="ship-stat-name">Скорость</span>
                    </div>
                    <div class="ship-stat-value-row">
                        <span id="ship-stat-speed" class="ship-stat-value">100%</span>
                        <span id="ship-stat-speed-cap" class="ship-stat-cap">/ 230%</span>
                    </div>
                    <div class="ship-stat-track">
                        <div id="ship-stat-speed-fill" class="ship-stat-fill" style="width:43%;"></div>
                    </div>
                </article>
                <article class="ship-stat" data-stat="shield" style="--accent:#a78bfa;">
                    <div class="ship-stat-header">
                        <span class="ship-stat-icon" aria-hidden="true">🛡</span>
                        <span class="ship-stat-name">Щиты</span>
                    </div>
                    <div class="ship-stat-value-row">
                        <span id="ship-stat-shield" class="ship-stat-value">100%</span>
                        <span id="ship-stat-shield-cap" class="ship-stat-cap">/ 210%</span>
                    </div>
                    <div class="ship-stat-track">
                        <div id="ship-stat-shield-fill" class="ship-stat-fill" style="width:48%;"></div>
                    </div>
                </article>
                <article class="ship-stat" data-stat="scanner" style="--accent:#5eead4;">
                    <div class="ship-stat-header">
                        <span class="ship-stat-icon" aria-hidden="true">🔭</span>
                        <span class="ship-stat-name">Сканер</span>
                    </div>
                    <div class="ship-stat-value-row">
                        <span id="ship-stat-scanner" class="ship-stat-value">1</span>
                        <span id="ship-stat-scanner-cap" class="ship-stat-cap">/ 8</span>
                    </div>
                    <div class="ship-stat-track">
                        <div id="ship-stat-scanner-fill" class="ship-stat-fill" style="width:13%;"></div>
                    </div>
                </article>
                <article class="ship-stat" data-stat="capacity" style="--accent:#fb923c;">
                    <div class="ship-stat-header">
                        <span class="ship-stat-icon" aria-hidden="true">💎</span>
                        <span class="ship-stat-name">Трюм</span>
                    </div>
                    <div class="ship-stat-value-row">
                        <span id="ship-stat-capacity" class="ship-stat-value">20</span>
                        <span id="ship-stat-capacity-cap" class="ship-stat-cap">/ 90</span>
                    </div>
                    <div class="ship-stat-track">
                        <div id="ship-stat-capacity-fill" class="ship-stat-fill" style="width:22%;"></div>
                    </div>
                </article>
            </div>
        </section>

        <!-- ═══ Upgrade Tracks (filled by JS) ═══════════════════════ -->
        <section id="upgrade-tree" class="ship-tracks" aria-label="Дерево апгрейдов">
            <p class="ship-tracks-loading">Загрузка апгрейдов…</p>
        </section>
    </div>
</main>
